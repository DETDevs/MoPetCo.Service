{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MoPetCoConectionString_BD": "${MOPETCO_DB_CONNECTION}"
  },
  "GoogleMaps": {
    "ApiKey": "${GOOGLE_MAPS_API_KEY}"
  },
  "CustomValues": [
    {
      "Name": "EmailConfiguration",
      "Values": {
        "smtpServer": "${SMTP_SERVER}",
        "smtpPort": "${SMTP_PORT}",
        "smtpUser": "${SMTP_USER}",
        "smtpPass": "${SMTP_PASS}"
      }
    },
    {
      "Name": "GoogleMaps",
      "Values": {
        "apiUrl": "${GOOGLE_MAPS_API_URL}",
        "apiKey": "${GOOGLE_MAPS_API_KEY}"
      }
    },
    {
      "Name": "GoogleCaptcha",
      "Values": {
        "apiUrl": "${GOOGLE_CAPTCHA_API_URL}",
        "secretKey": "${GOOGLE_CAPTCHA_SECRET_KEY}"
      }
    },
    {
      "Name": "FirebaseService",
      "Values": {
        "email": "${FIREBASE_EMAIL}",
        "password": "${FIREBASE_PASSWORD}",
        "apiKey": "${FIREBASE_API_KEY}",
        "authDomain": "${FIREBASE_AUTH_DOMAIN}",
        "projectUrl": "${FIREBASE_PROJECT_URL}"
      }
    }
  ]
}